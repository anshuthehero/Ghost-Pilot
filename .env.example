# Ghost Copilot Server Environment Configuration
# Step 1: Obtain your Groq API key from https://console.groq.com/keys
# Step 2: Paste your key below (replace 'your_groq_api_key_here')

# Required: Groq API Key for Whisper Speech-to-Text and LLM generation
GROQ_API_KEY=your_groq_api_key_here

# Server Host & Port binding
HOST=0.0.0.0
PORT=9471

# Optional: Bearer authentication token for securing client-to-server connections
# COPILOT_AUTH_TOKEN=your_optional_secret_bearer_token

# Optional: Custom JWT secret key (for session management)
# JWT_SECRET_KEY=your_custom_jwt_secret_key_minimum_32_characters
